# ================================
# Smart Energy AI - Git Ignore
# ================================

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# Raw and processed datasets
data/raw/*
data/processed/*
data/interim/*

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep

# Trained model binaries
# Production models are intentionally committed for cloud deployment
models/*.pkl
models/*.h5
models/*.keras

# Environment variables / secrets
.env
.env.*

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
tempCodeRunnerFile.py

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Ruff
.ruff_cache/

# Generated outputs
results/*
!results/.gitkeep

# Required production/demo dataset
!results/anomaly_detection_results.csv

